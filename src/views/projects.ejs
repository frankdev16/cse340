
<%- include('partials/header') %>
<main>
    <h2>
        <%= title %>
    </h2>
    <ul>
        <% projects.forEach(project=> { %>
            <li>
                <%= new Date(project.date).toDateString() %>:
                    <%= project.title %>
                        (<%= project.organization_name %>)
            </li>
            <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>
