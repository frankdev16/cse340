<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= project.title %>
        </h2>
        <p><strong>Description:</strong>
            <%= project.description %>
        </p>
        <p><strong>Date:</strong>
            <%= new Date(project.date).toDateString() %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Partner Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <h3>Category Tags:</h3>
        <% if (categories && categories.length> 0) { %>
            <ul>
                <% categories.forEach(cat=> { %>
                    <li>
                        <a href="/category/<%= cat.category_id %>">
                            <%= cat.name %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
            <% } else { %>
                <p>No category tags for this project.</p>
                <% } %>
            <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    </main>
    <%- include('partials/footer') %>