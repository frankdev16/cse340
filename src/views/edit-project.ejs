<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= project.project_id %>" method="POST">
            <div>
                <label for="title">Title:</label>
                <input type="text" id="title" name="title" value="<%= project.title %>" maxlength="200" required>
            </div>

            <div>
                <label for="description">Description:</label>
                <textarea id="description" name="description" maxlength="1000"
                    required><%= project.description %></textarea>
            </div>

            <div>
                <label for="date">Date:</label>
                <% const formattedDate=project.date ? new Date(project.date).toISOString().split('T')[0] : '' ; %>
                    <input type="date" id="date" name="date" value="<%= formattedDate %>" required>
            </div>

            <div>
                <label for="location">Location:</label>
                <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="200"
                    required>
            </div>

            <div>
                <label for="organizationId">Partner Organization:</label>
                <select id="organizationId" name="organizationId" required>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.organization_id %>"
                            <%=Number(org.organization_id)===Number(project.organization_id) ? 'selected' : '' %>>
                            <%= org.name %>
                        </option>
                        <% }) %>
                </select>
            </div>

            <button type="submit">Update Project</button>
        </form>
    </main>
    <%- include('partials/footer') %>