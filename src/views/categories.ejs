<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Here are the service project categories:</p>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <strong>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </strong>
                </li>
                <% }); %>
        </ul>
        <p><a href="/new-category">Add New Category</a></p>
    </main>
    <%- include('partials/footer') %>